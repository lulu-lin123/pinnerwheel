<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>今天吃點什麼好</title>
    <style>
        body {
            text-align: center;
            font-family: system-ui, -apple-system, sans-serif;
            background: #f4f4f9;
            margin: 0;
            padding: 20px;
        }
        h1 { color: #333; margin-bottom: 5px; }
        p { color: #666; margin-bottom: 15px; }
        .wheel-container {
            position: relative;
            width: 340px;
            height: 340px;
            margin: 0 auto 20px;
        }
        canvas {
            display: block;
            background: #fff;
            border-radius: 50%;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        }
        .arrow {
            position: absolute;
            top: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 0; height: 0;
            border-left: 12px solid transparent;
            border-right: 12px solid transparent;
            border-top: 22px solid #ff4757;
            z-index: 10;
        }
        button {
            padding: 12px 32px;
            font-size: 18px;
            font-weight: bold;
            cursor: pointer;
            background: #ff4757;
            color: white;
            border: none;
            border-radius: 25px;
            box-shadow: 0 4px 15px rgba(255, 71, 87, 0.4);
        }
        button:disabled { background: #ccc; cursor: not-allowed; }
        #result-box {
            margin-top: 20px;
            display: none;
        }
        .store-card {
            background: white;
            padding: 12px 16px;
            margin: 10px auto;
            width: 90%;
            max-width: 350px;
            border-radius: 12px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
            display: flex;
            justify-content: space-between;
            align-items: center;
            text-align: left;
        }
        .store-info h4 { margin: 0 0 5px 0; color: #333; font-size: 16px; }
        .store-info p { margin: 0; color: #666; font-size: 13px; }
        .nav-btn {
            background: #2ed573;
            color: white;
            text-decoration: none;
            padding: 8px 14px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: bold;
            white-space: nowrap;
        }
    </style>
</head>
<body>

    <h1>今天吃點什麼好</h1>
    <p>外食篇</p>

    <div class="wheel-container">
        <div class="arrow"></div>
        <canvas id="wheelCanvas" width="340" height="340"></canvas>
    </div>

    <button id="spinBtn" onclick="spinWheel()">開始轉動！</button>
    
    <div id="result-box">
        <h3 id="result-title"></h3>
        <p id="location-status" style="font-size: 12px; color: #888;">正在取得您的定位...</p>
        <div id="store-list"></div>
    </div>

    <script>
        const options = [
            { name: "火鍋/涮涮鍋", keyword: "火鍋 涮涮鍋" },
            { name: "日式拉麵", keyword: "日式拉麵" },
            { name: "義大利麵/披薩", keyword: "義大利麵 披薩" },
            { name: "便當/快餐", keyword: "便當 燒臘 自助餐" },
            { name: "牛肉麵/水餃", keyword: "牛肉麵 水餃館" },
            { name: "輕食", keyword: " 輕食 三明治" },
            { name: "韓式料理", keyword: "韓式料理 韓式燒肉" },
            { name: "泰式/越南料理", keyword: "泰式料理 越南河粉" },
            { name: "速食/炸雞", keyword: "麥當勞 肯德基 漢堡店" },
            { name: "小吃/滷肉飯", keyword: "小吃 滷肉飯 台灣小吃" },
            { name: "咖哩飯/丼飯", keyword: "咖哩飯 日式丼飯" },
            { name: "鹽酥雞/居酒屋", keyword: "鹽酥雞 居酒屋 宵夜" }
        ];

        const colors = [
            "#ff7675", "#74b9ff", "#ffeaa7", "#55efc4", 
            "#a29bfe", "#fab1a0", "#81ecec", "#dfe6e9",
            "#00b894", "#0984e3", "#e84393", "#fdcb6e"
        ];

        const canvas = document.getElementById('wheelCanvas');
        const ctx = canvas.getContext('2d');
        const center = canvas.width / 2;
        const radius = center - 10;
        
        let currentAngle = 0;
        let isSpinning = false;

        function drawWheel() {
            const arc = (2 * Math.PI) / options.length;
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            options.forEach((item, i) => {
                const angle = i * arc;
                ctx.beginPath();
                ctx.fillStyle = colors[i % colors.length];
                ctx.moveTo(center, center);
                ctx.arc(center, center, radius, angle, angle + arc);
                ctx.lineTo(center, center);
                ctx.fill();

                ctx.beginPath();
                ctx.strokeStyle = "#ffffff";
                ctx.lineWidth = 2;
                ctx.moveTo(center, center);
                ctx.lineTo(center + radius * Math.cos(angle), center + radius * Math.sin(angle));
                ctx.stroke();

                ctx.save();
                ctx.translate(center, center);
                ctx.rotate(angle + arc / 2);
                ctx.textAlign = "right";
                ctx.fillStyle = "#2d3436";
                ctx.font = "bold 12px system-ui, sans-serif";
                ctx.fillText(item.name, radius - 15, 4);
                ctx.restore();
            });

            ctx.beginPath();
            ctx.arc(center, center, radius, 0, 2 * Math.PI);
            ctx.strokeStyle = "#dfe6e9";
            ctx.lineWidth = 6;
            ctx.stroke();
        }

        function spinWheel() {
            if (isSpinning) return;
            isSpinning = true;

            document.getElementById('spinBtn').disabled = true;
            document.getElementById('result-box').style.display = 'none';

            const randomIndex = Math.floor(Math.random() * options.length);
            const sliceDegree = 360 / options.length;
            const targetCenterDegree = randomIndex * sliceDegree + sliceDegree / 2;
            let degreeNeeded = 270 - targetCenterDegree;

            const totalSpins = 360 * 6;
            currentAngle = currentAngle - (currentAngle % 360) + totalSpins + degreeNeeded;

            canvas.style.transition = "transform 4s cubic-bezier(0.15, 0.9, 0.3, 1)";
            canvas.style.transform = `rotate(${currentAngle}deg)`;

            setTimeout(() => {
                isSpinning = false;
                document.getElementById('spinBtn').disabled = false;
                
                const chosen = options[randomIndex];
                showResults(chosen);
            }, 4000);
        }

        function showResults(chosen) {
            const resultBox = document.getElementById('result-box');
            const resultTitle = document.getElementById('result-title');
            const statusText = document.getElementById('location-status');
            const storeList = document.getElementById('store-list');

            resultTitle.innerText = `🎉 決定吃：${chosen.name}！`;
            storeList.innerHTML = '';
            resultBox.style.display = 'block';

            if (navigator.geolocation) {
                statusText.innerText = "正在搜尋您附近的店家...";
                navigator.geolocation.getCurrentPosition(
                    (position) => {
                        const lat = position.coords.latitude;
                        const lng = position.coords.longitude;
                        statusText.innerText = "已取得位置，為您推薦附近店家：";
                        generateStoreCards(chosen.keyword, lat, lng);
                    },
                    (error) => {
                        statusText.innerText = "無法取得定位";
                        generateStoreCards(chosen.keyword, null, null);
                    },
                    { timeout: 15000 }
                );
            } else {
                statusText.innerText = "您的瀏覽器不支援定位";
                generateStoreCards(chosen.keyword, null, null);
            }
        }

        function generateStoreCards(keyword, lat, lng) {
            const storeList = document.getElementById('store-list');
            
            let mapsUrl;
            if (lat && lng) {
                mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(keyword)}&center=${lat},${lng}`;
            } else {
                mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(keyword)}`;
            }

            storeList.innerHTML = `
                <div class="store-card" style="background: #fff3f3; border: 1px dashed #ff4757;">
                    <div class="store-info">
                        <h4> 尋找「${keyword}」</h4>
                        <p>點擊右側按鈕，直接開啟地圖導航！</p>
                        <p>若未能成功請複製網址至瀏覽器貼上</p>
                    </div>
                    <a class="nav-btn" href="${mapsUrl}" target="_blank" rel="noopener noreferrer">準備出發</a>
                </div>
            `;
        }

        drawWheel();
    </script>
</body>
</html>
