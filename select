    }
  ];

  function matchRecipes() {
    const checked = Array.from(document.querySelectorAll('.chip input:checked')).map(i => i.value);
    const resultDiv = document.getElementById('results');
    resultDiv.innerHTML = "";

    if (checked.length === 0) {
      resultDiv.innerHTML = "<p style='text-align:center; color:#e74c3c;'>⚠️ 請至少勾選一項食材喔！</p>";
      return;
    }

    // 計算匹配度
    let matched = recipes.map(r => {
      let hasCount = r.req.filter(item => checked.includes(item)).length;
      let score = hasCount / r.req.length;
      return { ...r, score, hasCount };
    }).filter(r => r.hasCount > 0).sort((a, b) => b.score - a.score);

    if (matched.length === 0) {
      resultDiv.innerHTML = "<p style='text-align:center; color:#999;'>找不到符合的食譜，試試多勾選幾項食材吧！</p>";
      return;
    }

    matched.forEach(r => {
      let percent = Math.round(r.score * 100);
      let html = `
        <div class="recipe-card">
          <div class="recipe-header">
            <span class="recipe-title">${r.name}</span>
            <span class="tag">匹配度 ${percent}%</span>
          </div>
          <div class="recipe-detail">
            <b>• 食材：</b>${r.ing}<br>
            <b>• 醬汁：</b>${r.sea}
          </div>
          <a href="${r.url}" target="_blank" class="btn-link">📖 查看詳細步驟 ➔</a>
        </div>
      `;
      resultDiv.innerHTML += html;
    });
  }
</script>

</body>
</html>
